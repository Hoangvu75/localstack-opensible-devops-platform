<?xml version="1.0" encoding="UTF-8"?>
<!--
  disk-service (Java)

  No Spring Boot used. This service only needs to: query the Kubernetes API, listen on Kafka,
  and serve two health endpoints. The HTTP server built into the JDK (com.sun.net.httpserver)
  was originally sufficient, saving dozens of MBs in dependencies and seconds in startup time.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.learnopensible</groupId>
  <artifactId>disk-service</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Javalin replaces com.sun.net.httpserver: the OpenTelemetry agent instruments Javalin/Jetty
         but DOES NOT instrument the JDK built-in HTTP server. Verified by inspecting agent 2.10.0
         modules and runtime testing (/health generated 0 spans). Without this change, /metrics would
         lack a server span and the trace tree would break here silently. -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>6.7.0</version>
    </dependency>

    <dependency>
      <groupId>io.kubernetes</groupId>
      <artifactId>client-java</artifactId>
      <version>21.0.1</version>
    </dependency>

    <!-- Kafka client. Redpanda is protocol-compatible so this standard client works directly,
         and the javaagent automatically detects kafka-clients to create PRODUCER spans and inject traceparent. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.9.0</version>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>disk-service</finalName>
    <plugins>
      <!-- Package into a single fat jar so runtime stage only needs JRE + one file. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.learnopensible.disk.DiskService</mainClass>
                </transformer>
                <!-- Mandatory for shade: many libraries declare service loaders; merging jars without
                     merging META-INF/services causes OTel exporters not to be found. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
