# OpenSible Server Required Environment Variables
JWT_SECRET_KEY=your_opensible_jwt_secret_key_32chars_min
INTERNAL_CALL_SECRET=your_opensible_internal_call_secret_key_32chars_min
GLOBAL_SECRETS_ENCRYPTION_KEY=your_opensible_global_encryption_key_32chars_min
WORKER_REGISTRATION_SECRET=your_opensible_worker_reg_secret_32chars_min

# Admin Account Credentials for Practice
ADMIN_INITIAL_PASSWORD=YourStrongAdminPassword123!

# OpenSible Optional Configuration
FLASK_ENV=production
DATA_DIR=/app/data
TZ=Asia/Ho_Chi_Minh

AWS_ENDPOINT=http://localstack:4566
ECR_ENDPOINT=localstack:4510

# LocalStack Pro Auth Token
LOCALSTACK_PAT=your_localstack_auth_token_here

# GitHub Personal Access Token (requires write permissions to repository)
GITHUB_TOKEN=your_github_token_with_write_access
